			"mapper": {},
			"metadata": {
				"designer": {
					"x": 0,
					"y": 0
				},
				"restore": {
					"parameters": {
						"hook": {
							"data": {
								"editable": "true"
							},
							"label": "Generaciones_Equipo1"
						}
					}
				},
				"parameters": [
					{
						"name": "hook",
